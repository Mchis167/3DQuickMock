{
  "device": "iphone-17-pro-max",
  "screen": "assets/raw/iphone-17-pro-max/gltf/textures/17ProMax_Screen_baseColor.jpeg",

  "render": {
    "engine": "cycles",
    "samples": 48,
    "res": [1080, 1440],
    "fps": 30,
    "duration": 4.0
  },
  "world": { "hdri": "assets/hdri/studio_small_03.hdr", "strength": 0.6 },
  "camera": { "azimuth": 0.0, "elevation": 10.0, "frame_fill": 0.72, "focal": 85.0 },
  "output": { "dir": "renders/hero" },

  "_comment": "Có điểm đầu/cuối rõ ràng nên KHÔNG loop được — dùng cho clip đứng một mình.",
  "channels": {
    "camera.azimuth": {
      "keyframes": [
        { "frame": 1, "value": -40.0, "interpolation": "CUBIC", "easing": "EASE_IN_OUT" },
        { "frame": 121, "value": 25.0, "interpolation": "CUBIC", "easing": "EASE_IN_OUT" }
      ]
    },
    "camera.elevation": {
      "keyframes": [
        { "frame": 1, "value": 26.0, "interpolation": "SINE", "easing": "EASE_IN_OUT" },
        { "frame": 121, "value": 8.0, "interpolation": "SINE", "easing": "EASE_IN_OUT" }
      ]
    },
    "camera.distance": {
      "keyframes": [
        { "frame": 1, "value": 1.05, "interpolation": "QUART", "easing": "EASE_OUT" },
        { "frame": 121, "value": 0.78, "interpolation": "QUART", "easing": "EASE_OUT" }
      ]
    },
    "world.hdri_rotation": {
      "keyframes": [
        { "frame": 1, "value": 0.0, "interpolation": "LINEAR" },
        { "frame": 121, "value": 90.0, "interpolation": "LINEAR" }
      ]
    }
  }
}
