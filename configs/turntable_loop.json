{
  "device": "iphone-17-pro-max",
  "screen": "assets/raw/iphone-17-pro-max/gltf/textures/17ProMax_Screen_baseColor.jpeg",

  "render": {
    "engine": "cycles",
    "samples": 48,
    "res": [1080, 1440],
    "fps": 30,
    "duration": 5.0,
    "view_transform": "AgX"
  },

  "world": {
    "hdri": "assets/hdri/studio_small_03.hdr",
    "strength": 0.6,
    "rotation": 0.0,
    "reflector_strength": 0.0
  },

  "camera": {
    "azimuth": 0.0,
    "elevation": 10.0,
    "frame_fill": 0.72,
    "focal": 85.0
  },

  "output": { "dir": "renders/turntable", "name": "still" },

  "_comment": "LINEAR + extrapolation LINEAR = loop khép kín. Đổi sang easing thì mất tính loop.",
  "channels": {
    "device.spin_z": {
      "keyframes": [
        { "frame": 1, "value": 0.0, "interpolation": "LINEAR" },
        { "frame": 151, "value": 360.0, "interpolation": "LINEAR" }
      ],
      "extrapolation": "LINEAR"
    }
  }
}
